# TankBook — environment configuration
# Copy this file to .env and fill in your values before starting the stack.
#
#   cp .env.example .env

# PostgreSQL credentials
# Docker Compose uses these to configure both the database container and the
# app's DATABASE_URL — you only need to set them here.
DB_USER=tankbook
DB_PASSWORD=changeme

# Signs the short-lived cookie used during an OIDC login redirect (unrelated to
# regular login sessions, which are stored in the database). Optional — a
# random one is generated on each restart if left unset, which just means any
# OIDC login in progress at restart time has to be retried. Set this to a long
# random string to avoid that on a production instance.
SECRET_KEY=

# OIDC single sign-on (optional). Leave OIDC_ISSUER_URL unset to disable it —
# the login page will only show the local email/password form. All three of
# OIDC_ISSUER_URL, OIDC_CLIENT_ID, and OIDC_CLIENT_SECRET are required to
# enable it.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=SSO
